{
  "name": "efil-the-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun node_modules/vite/bin/vite.js",
    "build": "bun node_modules/typescript/bin/tsc --noEmit && bun --bun node_modules/vite/bin/vite.js build",
    "preview": "bun --bun node_modules/vite/bin/vite.js preview",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "lint:story": "bun tools/lint_story.ts",
    "assets": "tools/.venv/bin/python tools/build_assets.py",
    "story:extract": "python3 tools/extract_story.py"
  },
  "dependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
